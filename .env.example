# Backend
# روی Vercel با افزونه Postgres لازم نیست دستی ست شود (POSTGRES_URL خودکار
# خوانده می‌شود). برای بقیه هاست‌ها آدرس کامل را اینجا بگذارید.
DATABASE_URL=postgres://daryapak:daryapak_dev_2024@localhost:5432/daryapak
# اختیاری است: بدون آن کلید موقت ساخته می‌شود (لاگین با ری‌استارت می‌پرد).
JWT_SECRET=your-secret-key-here
PORT=4000
NODE_ENV=development

# Frontend (فقط توسعه لوکال)
# فرانت با مسیر نسبی `/api` کار می‌کند؛ روی Vercel هم‌مبدأ است و نیازی به تنظیم نیست.
VITE_API_TARGET=http://localhost:4000
